# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional API key for Groq Cloud inference (Qwen 3.8 27B).
# Configure this via Secrets panel or environment variable.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Render injects RENDER_EXTERNAL_URL automatically; AI Studio injects APP_URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT / NODE_ENV: Automatically injected by Render in production.
# NODE_ENV="production"
# PORT="10000"

# VITE_API_BASE_URL: Optional Render/Cloud backend origin baked into standalone Android APK builds.
# Example: "https://almamo-accounting.onrender.com"
VITE_API_BASE_URL=""

# ANDROID_PACKAGE_NAME & ANDROID_SHA256_FINGERPRINTS: Served dynamically at /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME="com.almamo.hardware"
ANDROID_SHA256_FINGERPRINTS=""


